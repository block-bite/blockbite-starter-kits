---
import SiteLayout from './SiteLayout.astro';

interface Props {
  title: string;
  description: string;
  published: Date;
  image: string;
  imageAlt: string;
}
const { title, description, published, image, imageAlt } = Astro.props;
const date = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeZone: 'UTC' }).format(published);
---

<SiteLayout title={`${title} — Le journal Miette Club`} description={description}>
  <article class="mx-auto max-w-4xl px-page-gutter py-12 md:px-16 md:py-20">
    <header class="mb-10 flex flex-col items-start gap-6">
      <a href="/le-journal/" class="text-label underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bordeaux transition-colors duration-(--duration-interaction) ease-interaction motion-reduce:transition-none hover:text-encre hover:decoration-2 focus-visible:text-encre focus-visible:decoration-2 active:text-bordeaux">← Le journal</a>
      <time datetime={published.toISOString().slice(0, 10)} class="text-eyebrow uppercase tracking-widest">{date}</time>
      <h1 class="font-display text-title-mobile leading-tight text-bordeaux md:text-section">{title}</h1>
      <p class="max-w-prose text-intro leading-relaxed">{description}</p>
    </header>
    <img src={image} alt={imageAlt} width="1125" height="750" class="rounded-image mb-10 h-auto w-full" />
    <div class="article-body max-w-prose text-base leading-relaxed"><slot /></div>
  </article>
</SiteLayout>

<style>
  .article-body :global(p),
  .article-body :global(ul) { margin-block: 1.25em; }
  .article-body :global(h2) {
    margin-block: 1.5em 0.5em;
    font-family: var(--font-display);
    font-size: var(--text-card);
    line-height: 1.2;
    color: var(--color-bordeaux);
  }
  .article-body :global(a) {
    color: var(--color-bordeaux);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    outline-offset: 4px;
    transition: color var(--duration-interaction) var(--ease-interaction);
  }
  .article-body :global(a:hover),
  .article-body :global(a:focus-visible) {
    color: var(--color-encre);
    text-decoration-thickness: 2px;
  }
  .article-body :global(a:focus-visible) { outline: 2px solid var(--color-bordeaux); }
  .article-body :global(a:active) { color: var(--color-bordeaux); background: var(--color-beurre); }
  @media (prefers-reduced-motion: reduce) {
    .article-body :global(a) { transition: none; }
  }
</style>
