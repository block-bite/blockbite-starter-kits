---
import type { IslandProps } from '@blockbite/astro/islands';
type Props = IslandProps<'menu/collection'>['products'][number] & { anchor?: string };
const { image, imageAlt, illustration, category, eyebrow, heading, description, price, detailsLabel, details, anchor } = Astro.props;
---

<article id={anchor} data-category={category} class="flex flex-col gap-3.5 pb-6">
  {illustration ? (
    <div class="rounded-image flex min-h-75 items-center justify-center bg-bordeaux p-7">
      <span class="text-center font-display text-title-mobile leading-tight text-creme md:text-display-sm">{illustration}</span>
    </div>
  ) : (
    <img src={image} alt={imageAlt} loading="lazy" width="960" height="1200" class="rounded-image h-75 w-full bg-ligne object-cover" />
  )}
  <p class="text-eyebrow font-semibold uppercase leading-relaxed tracking-[1.8px] text-encre">{eyebrow}</p>
  <h2 class="font-display text-brand-mobile leading-[1.04] tracking-[-0.7px] text-bordeaux md:tracking-[-1.5px]">{heading}</h2>
  <p class="text-base leading-relaxed text-encre">{description}</p>
  <p class="text-intro font-semibold leading-relaxed text-encre">{price}</p>
  <details class="w-full border-t border-ligne py-4 text-body leading-relaxed group open:border-bordeaux transition-colors duration-(--duration-interaction) ease-interaction motion-reduce:transition-none">
    <summary class="cursor-pointer font-medium rounded-button list-inside px-4 py-3 text-bordeaux transition-colors duration-(--duration-interaction) ease-interaction motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bordeaux hover:bg-beurre focus-visible:bg-beurre active:bg-bordeaux active:text-beurre group-open:bg-beurre group-open:active:bg-bordeaux">{detailsLabel}</summary>
    <p class="mt-3 max-w-prose">{details}</p>
  </details>
</article>
