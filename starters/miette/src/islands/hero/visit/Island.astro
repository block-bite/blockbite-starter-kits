---
import type { IslandProps } from '@blockbite/astro/islands';
type Props = IslandProps<'hero/visit'>;
const { invitationEyebrow, invitationHeading, invitationBody, invitationAction, invitationHref, image, imageAlt } = Astro.props;
---

<section class="bg-creme py-12 px-page-gutter gap-8 lg:gap-16 text-base text-left w-full max-w-full flex flex-col items-center justify-start md:py-20 md:px-16 lg:flex-row lg:flex-wrap">
  <div class="gap-7 text-base text-left max-w-full flex flex-col items-stretch justify-start lg:w-[calc(50%_-_32px)] md:grow-0 md:shrink-0 md:basis-auto w-full min-w-0">
    <p class="text-encre font-semibold text-eyebrow text-left max-w-full block min-w-0 leading-[1.65] tracking-[1.8px] uppercase whitespace-pre-wrap">{invitationEyebrow}</p>
    <h1 class="text-bordeaux font-display font-normal text-title-mobile text-left max-w-full block min-w-0 leading-[1.04] tracking-[-0.7px] whitespace-pre-wrap md:text-page md:tracking-[-1.5px]">{invitationHeading}</h1>
    <p class="text-encre text-base text-left max-w-full block min-w-0 leading-[1.65] whitespace-pre-wrap">{invitationBody}</p>
    <a class="bg-bordeaux text-beurre border-bordeaux border-1 rounded-button hover:bg-encre hover:border-encre focus-visible:outline-bordeaux font-medium py-3.5 px-6 text-label text-center w-fit max-w-full grow-0 shrink-0 basis-auto inline-flex min-w-0 whitespace-pre-wrap items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-4 motion-reduce:transition-none transition duration-(--duration-interaction) ease-interaction motion-safe:hover:-translate-y-interaction-lift motion-safe:focus-visible:-translate-y-interaction-lift motion-safe:active:translate-y-0 focus-visible:bg-encre focus-visible:border-encre active:bg-encre active:border-encre" href={invitationHref}>{invitationAction}</a>
  </div>
  <img class="rounded-image bg-ligne text-base text-left max-w-full grow-0 shrink-0 basis-auto h-100 min-h-0 lg:w-[calc(50%_-_32px)] md:h-[550px] object-cover w-full" src={image} alt={imageAlt} loading="lazy" width="960" height="1200" />
</section>
