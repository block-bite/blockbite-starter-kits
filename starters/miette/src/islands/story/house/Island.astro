---
import type { IslandProps } from '@blockbite/astro/islands';
type Props = IslandProps<'story/house'>;
const { notreHistoireEyebrow, notreHistoireHeading, notreHistoireBody, image, imageAlt } = Astro.props;
---

<section class="bg-creme py-12 px-page-gutter gap-8 lg:gap-16 text-base text-left w-full max-w-full flex flex-col items-center justify-start md:py-20 md:px-16 lg:flex-row lg:flex-wrap">
  <div class="gap-7 text-base text-left max-w-full flex flex-col items-stretch justify-start lg:w-[calc(50%_-_32px)] md:grow-0 md:shrink-0 md:basis-auto w-full min-w-0">
    <p class="text-encre font-semibold text-eyebrow text-left max-w-full block min-w-0 leading-[1.65] tracking-[1.8px] uppercase whitespace-pre-wrap">{notreHistoireEyebrow}</p>
    <h1 class="text-bordeaux font-display font-normal text-title-mobile text-left max-w-full block min-w-0 leading-[1.04] tracking-[-0.7px] whitespace-pre-wrap md:text-invitation md:tracking-[-1.5px]">{notreHistoireHeading}</h1>
    <p class="text-encre text-base text-left max-w-full block min-w-0 leading-[1.65] whitespace-pre-wrap">{notreHistoireBody}</p>
  </div>
  <img class="rounded-image bg-ligne text-base text-left max-w-full grow-0 shrink-0 basis-auto h-90 min-h-0 lg:w-[calc(50%_-_32px)] md:h-145 object-cover w-full" src={image} alt={imageAlt} loading="lazy" width="1200" height="800" />
</section>
