---
import type { IslandProps } from '@blockbite/astro/islands';
import arrowDownRight from '../../../../brand/assets/824b8f41-1dcd-4f2c-b8d3-e2bf9bf7be56.svg?url';

type Props = IslandProps<'catalog/best-sellers'>;
const {
  heading,
  chalkName, chalkColour, chalkPrice, chalkImage, chalkAlt, chalkHref,
  moveName, moveColour, movePrice, moveImage, moveAlt,
  teeName, teeColour, teePrice, teeImage, teeAlt, teeHref,
} = Astro.props;
---

<section id="best-sellers" class="min-h-dvh content-center shifft-gutter bg-paper py-14 text-carbon sm:py-20 lg:py-26" aria-labelledby="best-sellers-heading">
  <h2 id="best-sellers-heading" class="shifft-display text-[clamp(3rem,7.6vw,8rem)] uppercase">{heading}</h2>

  <ul class="mt-8 grid list-none grid-cols-1 gap-x-4 gap-y-9 border-t border-carbon pt-4 sm:mt-10 sm:grid-cols-3 lg:gap-x-6 lg:pt-6">
    <li class="product-card min-w-0">
      <a href={chalkHref} aria-labelledby="best-chalk-name best-chalk-colour" class="group block text-inherit focus-visible:outline-none">
        <div class="relative grid aspect-[6/5] grid-cols-1 grid-rows-1 place-items-center overflow-hidden rounded-media bg-ice">
          <img src={chalkImage} alt={chalkAlt} width="1302" height="1208" loading="lazy" decoding="async" class="h-[88%] w-[90%] object-contain product-card-image" />
        </div>
        <div class="mt-3 grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-2 gap-y-1">
          <h3 id="best-chalk-name" class="text-[clamp(1.08rem,1.65vw,1.65rem)] leading-[1.1] font-black tracking-tight italic underline-offset-4 group-hover:underline group-focus-visible:underline">{chalkName}</h3>
          <p class="text-sm font-semibold tabular-nums">{chalkPrice}</p>
          <p id="best-chalk-colour" class="self-center text-sm text-carbon/75">{chalkColour}</p>
          <span class="product-card-link-icon shifft-pill">
            <img src={arrowDownRight} width="16" height="16" alt="" />
          </span>
        </div>
      </a>
    </li>
    <li class="product-card min-w-0">
      <div class="grid aspect-[6/5] grid-cols-1 grid-rows-1 place-items-center overflow-hidden rounded-media bg-blush">
        <img src={moveImage} alt={moveAlt} width="900" height="1125" loading="lazy" decoding="async" class="h-[85%] w-[88%] object-contain product-card-image" />
      </div>
      <div class="mt-3 grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-2 gap-y-1">
        <h3 class="text-[clamp(1.08rem,1.65vw,1.65rem)] leading-[1.1] font-black tracking-tight italic">{moveName}</h3>
        <p class="text-sm font-semibold tabular-nums">{movePrice}</p>
        <p class="col-span-2 text-sm text-carbon/75">{moveColour}</p>
      </div>
    </li>
    <li class="product-card min-w-0">
      <a href={teeHref} aria-labelledby="best-tee-name best-tee-colour" class="group block text-inherit focus-visible:outline-none">
        <div class="relative grid aspect-[6/5] grid-cols-1 grid-rows-1 place-items-center overflow-hidden rounded-media bg-lilac">
          <img src={teeImage} alt={teeAlt} width="1122" height="1402" loading="lazy" decoding="async" class="h-[85%] w-[88%] object-contain product-card-image" />
        </div>
        <div class="mt-3 grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-2 gap-y-1">
          <h3 id="best-tee-name" class="text-[clamp(1.08rem,1.65vw,1.65rem)] leading-[1.1] font-black tracking-tight italic underline-offset-4 group-hover:underline group-focus-visible:underline">{teeName}</h3>
          <p class="text-sm font-semibold tabular-nums">{teePrice}</p>
          <p id="best-tee-colour" class="self-center text-sm text-carbon/75">{teeColour}</p>
          <span class="product-card-link-icon shifft-pill">
            <img src={arrowDownRight} width="16" height="16" alt="" />
          </span>
        </div>
      </a>
    </li>
  </ul>
</section>
