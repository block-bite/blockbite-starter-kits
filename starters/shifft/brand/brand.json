        "tone_of_voice": {
          "enabled": true,
          "introduction": "Direct. Energetic. Ready to move.\nProposed voice guidance, inspired by the supplied campaign.",
          "instructions": "Proposed voice: use short, active sentences and familiar words. Let MOVE WITHOUT LIMITS set the rhythm. Be encouraging without judging the reader. Preserve verified facts; never invent fabric, sustainability, performance or product claims.",
          "provenance": "proposed",
          "source_asset_ids": [],
          "prompts": [
            {
              "inputs": [
                "source_copy",
                "audience",
                "channel"
              ],
              "reference_asset_ids": [],
              "id": "next-use",
              "title": "Write in our voice",
              "purpose": "Turn source copy into a clear, useful message.",
              "template": "Rewrite {{source_copy}} for {{audience}} on {{channel}}. Keep the factual meaning, follow the saved voice principles and preferred terms, and avoid unsupported claims. Return one concise version and describe any factual gaps."
            }
          ],
          "principles": [
            {
              "title": "Lead with a verb.",
              "description": "Move. Explore. Go. Give the line a clear sense of direction."
            },
            {
              "title": "Keep the energy human.",
              "description": "Invite people in. Leave room for different paces and ambitions."
            },
            {
              "title": "Make every claim count.",
              "description": "Use verified product facts. When details are missing, ask for them."
            }
          ],
          "preferred_terms": [
            "move",
            "explore",
            "your next step"
          ],
          "avoid_terms": [
            "best in class",
            "unstoppable performance",
            "guaranteed results"
